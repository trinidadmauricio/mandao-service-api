// Prisma Schema - LogiHub Delivery Platform
// Multi-schema setup: shared, delivery, retail

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["shared", "delivery", "retail"]
}

// ============================================
// SCHEMA: shared
// Entities: Tenants, Users, Auth, Branches
// ============================================

model Tenant {
  id                    String   @id @default(uuid())
  slug                  String   @unique
  name                  String
  type                  TenantType
  subscription_plan_id  String?
  subscription_status   SubscriptionStatus @default(TRIAL)
  subscription_expires_at DateTime?
  settings              Json?
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  subscription_plan SubscriptionPlan? @relation(fields: [subscription_plan_id], references: [id])
  users             User[]
  branches          Branch[]
  order_counters    OrderCounter[]
  oauth_clients     OAuthClient[]
  
  @@map("tenants")
  @@schema("shared")
}

enum TenantType {
  RETAIL
  ON_DEMAND
  HYBRID
  
  @@schema("shared")
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
  
  @@schema("shared")
}

model SubscriptionPlan {
  id                  String   @id @default(uuid())
  name                String
  type                PlanType
  price_monthly       Decimal  @db.Decimal(10, 2)
  price_yearly        Decimal  @db.Decimal(10, 2)
  features            Json
  max_products        Int?
  max_orders_month    Int?
  max_branches        Int?
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  tenants Tenant[]
  
  @@map("subscription_plans")
  @@schema("shared")
}

enum PlanType {
  BASIC
  PRO
  ENTERPRISE
  CUSTOM
  
  @@schema("shared")
}

model User {
  id                      String    @id @default(uuid())
  tenant_id               String?
  email                   String    @unique
  password_hash           String
  role                    UserRole
  first_name              String
  last_name               String
  phone                   String?
  email_verified_at       DateTime?
  email_verification_token String?
  password_reset_token    String?
  password_reset_expires_at DateTime?
  last_login_at           DateTime?
  failed_login_attempts   Int       @default(0)
  locked_until            DateTime?
  status                  UserStatus @default(ACTIVE)
  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt

  tenant                 Tenant?     @relation(fields: [tenant_id], references: [id])
  oauth_authorization_codes OAuthAuthorizationCode[]
  oauth_access_tokens    OAuthAccessToken[]
  oauth_refresh_tokens   OAuthRefreshToken[]
  audit_logs             AuditLog[]
  
  @@map("users")
  @@schema("shared")
}

enum UserRole {
  SAAS_ADMIN
  SAAS_EDITOR
  OWNER
  SUPERVISOR
  MERCHANT_USER
  CUSTOMER
  
  @@schema("shared")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  
  @@schema("shared")
}

model Branch {
  id              String   @id @default(uuid())
  tenant_id       String
  name            String
  address         String
  gps_lat         Decimal  @db.Decimal(10, 8)
  gps_lng         Decimal  @db.Decimal(11, 8)
  contact_phone   String
  is_main         Boolean  @default(false)
  operating_hours Json?
  status          BranchStatus @default(ACTIVE)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenant_id], references: [id])
  
  @@map("branches")
  @@schema("shared")
}

enum BranchStatus {
  ACTIVE
  INACTIVE
  
  @@schema("shared")
}

model OrderCounter {
  id              String   @id @default(uuid())
  tenant_id       String   @unique
  current_value   BigInt   @default(0)
  prefix          String?
  padding_length  Int      @default(6)
  last_reset_at   DateTime?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenant_id], references: [id])
  
  @@map("order_counters")
  @@schema("shared")
}

// OAuth2 Models

model OAuthClient {
  id              String   @id @default(uuid())
  tenant_id       String?
  client_id       String   @unique
  client_secret_hash String
  name            String
  redirect_uris   Json
  grant_types     Json
  scope           String
  is_confidential Boolean
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  tenant                  Tenant?     @relation(fields: [tenant_id], references: [id])
  authorization_codes     OAuthAuthorizationCode[]
  access_tokens           OAuthAccessToken[]
  refresh_tokens          OAuthRefreshToken[]
  
  @@map("oauth_clients")
  @@schema("shared")
}

model OAuthAuthorizationCode {
  id            String   @id @default(uuid())
  code          String   @unique
  client_id     String
  user_id       String
  redirect_uri  String
  scope         String
  expires_at    DateTime
  is_used       Boolean  @default(false)
  created_at    DateTime @default(now())

  client OAuthClient @relation(fields: [client_id], references: [client_id])
  user   User        @relation(fields: [user_id], references: [id])
  
  @@index([code])
  @@map("oauth_authorization_codes")
  @@schema("shared")
}

model OAuthAccessToken {
  id         String   @id @default(uuid())
  token      String   @unique
  client_id  String
  user_id    String?
  scope      String
  expires_at DateTime
  is_revoked Boolean  @default(false)
  created_at DateTime @default(now())

  client OAuthClient @relation(fields: [client_id], references: [client_id])
  user   User?       @relation(fields: [user_id], references: [id])
  refresh_tokens OAuthRefreshToken[]
  
  @@index([token])
  @@map("oauth_access_tokens")
  @@schema("shared")
}

model OAuthRefreshToken {
  id              String   @id @default(uuid())
  token           String   @unique
  access_token_id String
  client_id       String
  user_id         String
  expires_at      DateTime
  is_revoked      Boolean  @default(false)
  created_at      DateTime @default(now())

  access_token OAuthAccessToken @relation(fields: [access_token_id], references: [id])
  client       OAuthClient      @relation(fields: [client_id], references: [client_id])
  user         User             @relation(fields: [user_id], references: [id])
  
  @@index([token])
  @@map("oauth_refresh_tokens")
  @@schema("shared")
}

model AuditLog {
  id          String   @id @default(uuid())
  tenant_id   String
  user_id     String?
  entity_type String
  entity_id   String
  action      AuditAction
  old_values  Json?
  new_values  Json?
  ip_address  String?
  user_agent  String?
  created_at  DateTime @default(now())

  user User? @relation(fields: [user_id], references: [id])
  
  @@index([tenant_id])
  @@index([entity_type, entity_id])
  @@map("audit_logs")
  @@schema("shared")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  
  @@schema("shared")
}

// ============================================
// SCHEMA: delivery
// Entities: Orders, Drivers, Vehicles, Logistics
// ============================================

model LogisticsProvider {
  id                    String   @id @default(uuid())
  tenant_id             String?
  company_name          String
  tax_id                String
  representative_name   String
  representative_phone  String
  representative_document String
  verification_status   VerificationStatus @default(PENDING)
  verification_documents Json?
  rating_avg            Decimal? @db.Decimal(3, 2)
  total_deliveries      Int      @default(0)
  status                ProviderStatus @default(ACTIVE)
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  drivers      Driver[]
  vehicles     Vehicle[]
  order_drivers OrderDriver[]
  
  @@map("logistics_providers")
  @@schema("delivery")
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  
  @@schema("delivery")
}

enum ProviderStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
  
  @@schema("delivery")
}

model Driver {
  id                    String   @id @default(uuid())
  logistics_provider_id String
  user_id               String
  identity_document     String
  driving_license       String
  date_of_birth         DateTime
  emergency_contact     Json
  has_own_vehicle       Boolean
  vehicle_id            String?
  work_type             WorkType
  work_zone             String? // PostGIS geography - stored as WKT
  availability_status   DriverStatus @default(AVAILABLE)
  rating_avg            Decimal? @db.Decimal(3, 2)
  total_deliveries      Int      @default(0)
  documents             Json
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  logistics_provider LogisticsProvider @relation(fields: [logistics_provider_id], references: [id])
  vehicle            Vehicle?          @relation(fields: [vehicle_id], references: [id])
  order_drivers      OrderDriver[]
  delivery_ratings   DeliveryRating[]
  
  @@map("drivers")
  @@schema("delivery")
}

enum WorkType {
  FULL_TIME
  PART_TIME
  FREELANCE
  
  @@schema("delivery")
}

enum DriverStatus {
  AVAILABLE
  BUSY
  OFFLINE
  SUSPENDED
  
  @@schema("delivery")
}

model Vehicle {
  id                    String   @id @default(uuid())
  logistics_provider_id String?
  driver_id             String?
  vehicle_type          VehicleType
  license_plate         String   @unique
  brand                 String
  model                 String
  year                  Int
  color                 String
  insurance_policy      String
  insurance_expires_at  DateTime
  last_maintenance_at   DateTime?
  status                VehicleStatus @default(AVAILABLE)
  specifications        Json?
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  logistics_provider LogisticsProvider? @relation(fields: [logistics_provider_id], references: [id])
  drivers            Driver[]
  
  @@map("vehicles")
  @@schema("delivery")
}

enum VehicleType {
  MOTORCYCLE
  SEDAN
  MINI_VAN
  PANEL
  TRUCK
  PICKUP
  
  @@schema("delivery")
}

enum VehicleStatus {
  AVAILABLE
  IN_SERVICE
  MAINTENANCE
  OUT_OF_SERVICE
  
  @@schema("delivery")
}

model DeliveryZone {
  id               String   @id @default(uuid())
  tenant_id        String
  name             String
  boundary         String   // PostGIS geography - stored as WKT
  base_rate        Decimal  @db.Decimal(10, 2)
  rate_per_km      Decimal  @db.Decimal(10, 2)
  surge_multiplier Decimal  @db.Decimal(3, 2) @default(1.0)
  is_active        Boolean  @default(true)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  delivery_rates DeliveryRate[]
  
  @@map("delivery_zones")
  @@schema("delivery")
}

model DeliveryRate {
  id                String      @id @default(uuid())
  tenant_id         String
  zone_id           String?
  vehicle_type      VehicleType
  distance_km_min   Decimal     @db.Decimal(10, 2)
  distance_km_max   Decimal     @db.Decimal(10, 2)
  base_price        Decimal     @db.Decimal(10, 2)
  price_per_km      Decimal     @db.Decimal(10, 2)
  priority_multiplier Json
  created_at        DateTime    @default(now())
  updated_at        DateTime    @updatedAt

  zone DeliveryZone? @relation(fields: [zone_id], references: [id])
  
  @@map("delivery_rates")
  @@schema("delivery")
}

model Order {
  id                    String     @id @default(uuid())
  tenant_id             String
  order_number          BigInt
  order_display_number  String
  order_type            OrderType
  customer_id           String?
  customer_snapshot     Json
  delivery_address      Json
  delivery_lat          Decimal    @db.Decimal(10, 8)
  delivery_lng          Decimal    @db.Decimal(11, 8)
  pickup_address        Json?
  pickup_lat            Decimal?   @db.Decimal(10, 8)
  pickup_lng            Decimal?   @db.Decimal(11, 8)
  status                OrderStatus @default(PENDING)
  cancellation_reason   String?
  scheduled_pickup_at   DateTime?
  estimated_delivery_at DateTime
  special_instructions  String?
  priority              OrderPriority @default(NORMAL)
  cargo_description     String?
  tracking_code         String     @unique
  created_at            DateTime   @default(now())
  updated_at            DateTime   @updatedAt

  order_branches        OrderBranch[]
  order_drivers         OrderDriver[]
  order_items           OrderItem[]
  order_summary_totals  OrderSummaryTotal[]
  order_status_history  OrderStatusHistory[]
  delivery_proofs       OrderDeliveryProof[]
  delivery_ratings      DeliveryRating[]
  payment_transactions  PaymentTransaction[]
  
  @@index([tenant_id, status])
  @@index([tracking_code])
  @@index([created_at])
  @@map("orders")
  @@schema("delivery")
}

enum OrderType {
  RETAIL
  ON_DEMAND
  
  @@schema("delivery")
}

enum OrderStatus {
  DRAFT
  PENDING
  CONFIRMED
  ASSIGNED
  IN_TRANSIT
  DELIVERED
  CANCELLED
  FAILED
  
  @@schema("delivery")
}

enum OrderPriority {
  NORMAL
  URGENT
  
  @@schema("delivery")
}

model OrderBranch {
  id                String   @id @default(uuid())
  order_id          String
  branch_id         String
  branch_snapshot   Json
  assigned_at       DateTime @default(now())
  is_current        Boolean  @default(true)
  assigned_by_user_id String?
  created_at        DateTime @default(now())

  order Order @relation(fields: [order_id], references: [id])
  
  @@index([order_id, is_current])
  @@map("order_branches")
  @@schema("delivery")
}

model OrderDriver {
  id                    String    @id @default(uuid())
  order_id              String
  driver_id             String?
  logistics_provider_id String
  driver_snapshot       Json
  assigned_at           DateTime  @default(now())
  unassigned_at         DateTime?
  is_current            Boolean   @default(true)
  assigned_by_user_id   String?
  created_at            DateTime  @default(now())

  order              Order             @relation(fields: [order_id], references: [id])
  driver             Driver?           @relation(fields: [driver_id], references: [id])
  logistics_provider LogisticsProvider @relation(fields: [logistics_provider_id], references: [id])
  
  @@index([order_id, is_current])
  @@index([driver_id, is_current])
  @@map("order_drivers")
  @@schema("delivery")
}

model OrderItem {
  id               String   @id @default(uuid())
  order_id         String
  product_id       String?
  variant_id       String?
  product_snapshot Json
  quantity         Decimal  @db.Decimal(10, 3)
  unit_price       Decimal  @db.Decimal(10, 2)
  subtotal         Decimal  @db.Decimal(10, 2)
  notes            String?
  created_at       DateTime @default(now())

  order Order @relation(fields: [order_id], references: [id])
  
  @@index([order_id])
  @@map("order_items")
  @@schema("delivery")
}

model OrderSummaryTotal {
  id                    String   @id @default(uuid())
  order_id              String
  version               Int
  subtotal              Decimal  @db.Decimal(10, 2)
  tax_rate              Decimal  @db.Decimal(5, 4)
  tax_amount            Decimal  @db.Decimal(10, 2)
  delivery_fee          Decimal  @db.Decimal(10, 2)
  discount_amount       Decimal  @db.Decimal(10, 2) @default(0)
  total_amount          Decimal  @db.Decimal(10, 2)
  currency              String   @default("USD")
  calculation_metadata  Json?
  is_current            Boolean  @default(true)
  created_at            DateTime @default(now())

  order Order @relation(fields: [order_id], references: [id])
  
  @@index([order_id, is_current])
  @@map("order_summary_totals")
  @@schema("delivery")
}

model OrderStatusHistory {
  id                  String      @id @default(uuid())
  order_id            String
  from_status         OrderStatus?
  to_status           OrderStatus
  changed_by_user_id  String?
  driver_location     String?     // PostGIS geography
  notes               String?
  created_at          DateTime    @default(now())

  order Order @relation(fields: [order_id], references: [id])
  
  @@index([order_id, created_at])
  @@map("order_status_history")
  @@schema("delivery")
}

model OrderDeliveryProof {
  id                String         @id @default(uuid())
  order_id          String
  proof_type        DeliveryProofType
  proof_data        Json
  delivered_to_name String
  delivered_at      DateTime
  driver_notes      String?
  created_at        DateTime       @default(now())

  order Order @relation(fields: [order_id], references: [id])
  
  @@map("order_delivery_proofs")
  @@schema("delivery")
}

enum DeliveryProofType {
  SIGNATURE
  PHOTO
  CODE
  NONE
  
  @@schema("delivery")
}

model DeliveryRating {
  id              String   @id @default(uuid())
  order_id        String
  driver_id       String
  customer_rating Int
  driver_rating   Int?
  customer_comment String?
  driver_comment  String?
  created_at      DateTime @default(now())

  order  Order  @relation(fields: [order_id], references: [id])
  driver Driver @relation(fields: [driver_id], references: [id])
  
  @@map("delivery_ratings")
  @@schema("delivery")
}

model PaymentTransaction {
  id                String            @id @default(uuid())
  order_id          String
  tenant_id         String
  transaction_type  TransactionType
  payment_method    PaymentMethod
  payment_intent_id String?
  charge_id         String?
  refund_id         String?
  amount            Decimal           @db.Decimal(10, 2)
  currency          String            @default("USD")
  status            PaymentStatus     @default(PENDING)
  failure_reason    String?
  card_last4        String?
  card_brand        String?
  metadata          Json?
  created_at        DateTime          @default(now())
  updated_at        DateTime          @updatedAt

  order Order @relation(fields: [order_id], references: [id])
  
  @@index([order_id])
  @@index([status])
  @@map("payment_transactions")
  @@schema("delivery")
}

enum TransactionType {
  CHARGE
  REFUND
  AUTHORIZATION
  CAPTURE
  
  @@schema("delivery")
}

enum PaymentMethod {
  CARD
  CASH
  TRANSFER
  WALLET
  
  @@schema("delivery")
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  
  @@schema("delivery")
}

// ============================================
// SCHEMA: retail
// Entities: Products, Inventory, Storefront
// ============================================

model Storefront {
  id              String   @id @default(uuid())
  tenant_id       String   @unique
  subdomain       String   @unique
  custom_domain   String?  @unique
  is_active       Boolean  @default(true)
  theme_config    Json
  seo_config      Json?
  business_hours  Json?
  about_us        String?
  terms           String?
  privacy_policy  String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  
  @@map("storefronts")
  @@schema("retail")
}

model Category {
  id            String         @id @default(uuid())
  tenant_id     String
  parent_id     String?
  name          String
  slug          String
  description   String?
  image_url     String?
  display_order Int            @default(0)
  is_active     Boolean        @default(true)
  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt

  parent   Category?  @relation("CategoryHierarchy", fields: [parent_id], references: [id])
  children Category[] @relation("CategoryHierarchy")
  products Product[]
  
  @@unique([tenant_id, slug])
  @@map("categories")
  @@schema("retail")
}

model Brand {
  id          String   @id @default(uuid())
  tenant_id   String
  name        String
  slug        String
  logo_url    String?
  description String?
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  products Product[]
  
  @@unique([tenant_id, slug])
  @@map("brands")
  @@schema("retail")
}

model Product {
  id                  String   @id @default(uuid())
  tenant_id           String
  sku                 String
  barcode             String?
  name                String
  description         String?
  category_id         String
  brand_id            String?
  cost_price          Decimal  @db.Decimal(10, 2)
  selling_price       Decimal  @db.Decimal(10, 2)
  compare_at_price    Decimal? @db.Decimal(10, 2)
  track_inventory     Boolean  @default(true)
  current_stock       Int      @default(0)
  min_stock_alert     Int      @default(0)
  uom                 UnitOfMeasure @default(UNIT)
  weight_kg           Decimal? @db.Decimal(10, 3)
  dimensions          Json?
  images              Json
  featured_image_url  String?
  has_variants        Boolean  @default(false)
  is_active           Boolean  @default(true)
  is_featured         Boolean  @default(false)
  meta_title          String?
  meta_description    String?
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  category           Category          @relation(fields: [category_id], references: [id])
  brand              Brand?            @relation(fields: [brand_id], references: [id])
  variants           ProductVariant[]
  inventory_movements InventoryMovement[]
  stock_by_branch    StockByBranch[]
  
  @@unique([tenant_id, sku])
  @@index([tenant_id, is_active])
  @@map("products")
  @@schema("retail")
}

enum UnitOfMeasure {
  UNIT
  KG
  G
  LITER
  ML
  BOX
  PACK
  
  @@schema("retail")
}

model ProductVariant {
  id                String   @id @default(uuid())
  product_id        String
  tenant_id         String
  sku               String
  barcode           String?
  option1_name      String?
  option1_value     String?
  option2_name      String?
  option2_value     String?
  option3_name      String?
  option3_value     String?
  price_adjustment  Decimal  @db.Decimal(10, 2) @default(0)
  cost_price        Decimal? @db.Decimal(10, 2)
  track_inventory   Boolean  @default(true)
  current_stock     Int      @default(0)
  weight_kg         Decimal? @db.Decimal(10, 3)
  image_url         String?
  is_active         Boolean  @default(true)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  product            Product             @relation(fields: [product_id], references: [id])
  inventory_movements InventoryMovement[]
  stock_by_branch    StockByBranch[]
  
  @@unique([tenant_id, sku])
  @@index([product_id])
  @@map("product_variants")
  @@schema("retail")
}

model InventoryMovement {
  id              String         @id @default(uuid())
  tenant_id       String
  product_id      String
  variant_id      String?
  branch_id       String
  movement_type   MovementType
  quantity        Int
  stock_before    Int
  stock_after     Int
  reference_type  ReferenceType?
  reference_id    String?
  notes           String?
  created_by_user_id String
  created_at      DateTime       @default(now())

  product Product         @relation(fields: [product_id], references: [id])
  variant ProductVariant? @relation(fields: [variant_id], references: [id])
  
  @@index([tenant_id, created_at])
  @@map("inventory_movements")
  @@schema("retail")
}

enum MovementType {
  PURCHASE
  SALE
  ADJUSTMENT
  TRANSFER
  RETURN
  
  @@schema("retail")
}

enum ReferenceType {
  ORDER
  ADJUSTMENT
  TRANSFER
  
  @@schema("retail")
}

model StockByBranch {
  id              String   @id @default(uuid())
  tenant_id       String
  product_id      String
  variant_id      String?
  branch_id       String
  current_stock   Int      @default(0)
  reserved_stock  Int      @default(0)
  available_stock Int      @default(0)
  last_updated_at DateTime @updatedAt
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  product Product         @relation(fields: [product_id], references: [id])
  variant ProductVariant? @relation(fields: [variant_id], references: [id])
  
  @@unique([product_id, variant_id, branch_id])
  @@index([tenant_id, branch_id])
  @@map("stock_by_branch")
  @@schema("retail")
}
